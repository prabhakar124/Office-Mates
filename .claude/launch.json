{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uv", "run", "--directory", "apps/backend", "uvicorn", "officemates.main:app", "--port", "8000"],
      "port": 8000
