# Copy to .env for local development. Never commit a real .env.
OM_ENVIRONMENT=local
OM_LOG_LEVEL=INFO
OM_LOG_JSON=false
OM_GIT_SHA=dev
OM_CORS_ORIGINS=["http://localhost:3000"]
# Optional: enables the Redis readiness check and is used by the Celery worker.
# OM_REDIS_URL=redis://localhost:6379/0
# Optional: MySQL from Docker Compose (host port 3310). Use the passwords from the root .env.
# OM_DATABASE_URL=mysql+asyncmy://app_rw:CHANGE_ME@127.0.0.1:3310/officemates
# OM_DATABASE_MIGRATION_URL=mysql+asyncmy://migrator:CHANGE_ME@127.0.0.1:3310/officemates
