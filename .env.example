# Local Docker Compose settings. Copy to .env and replace every CHANGE_ME value.
# .env is git-ignored: never commit real values.

# MySQL (local container only)
MYSQL_ROOT_PASSWORD=CHANGE_ME
# Restricted accounts (letters, digits, - and _ only: they are placed inside URLs)
MYSQL_APP_PASSWORD=CHANGE_ME
MYSQL_MIGRATOR_PASSWORD=CHANGE_ME
MYSQL_READONLY_PASSWORD=CHANGE_ME
MYSQL_HOST_PORT=3310

# SeaweedFS (local S3 stand-in). Any strings work; these are not real AWS keys.
S3_ACCESS_KEY_ID=officemates-local
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=officemates-local
